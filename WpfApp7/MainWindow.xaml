<Window x:Class="WpfApp7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp7"
        mc:Ignorable="d"
        Title="MainWindow" Height="520" Width="760">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Добавить автобус" Grid.Row="0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Марка" Grid.Row="0" Grid.Column="0" Margin="4"/>
                <TextBox x:Name="txtBrand" Grid.Row="0" Grid.Column="1" Margin="4"/>
                <TextBlock Text="Маршрут" Grid.Row="0" Grid.Column="2" Margin="4"/>
                <TextBox x:Name="txtRoute" Grid.Row="0" Grid.Column="3" Margin="4"/>
                <TextBlock Text="Вместитмость" Grid.Row="1" Grid.Column="0" Margin="4"/>
                <TextBox x:Name="txtCapacity" Grid.Row="1" Grid.Column="1" Margin="4"/>
                <TextBlock Text="Макс.Скорость" Grid.Row="1" Grid.Column="2" Margin="4"/>
                <TextBox x:Name="txtSpeed" Grid.Row="1" Grid.Column="3" Margin="4"/>
            </Grid>
        </GroupBox>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,8">
            <Button Content="Добавить" Width="120" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button Content="Удалить" Width="120" Margin="0,0,8,0" Click="BtnRemove_Click"/>
            <Button Content="Сортировать по вместимости" Width="220" Margin="0,0,8,0" Click="BtnSort_Click"/>
        </StackPanel>
        <ListBox x:Name="lstBuses" Grid.Row="2" FontSize="13"/>
        <GroupBox Header="Сравнение по вместимости" Grid.Row="3" Margin="0,8,0,0" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Автобус 1:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbFirst" Width="220" DisplayMemberPath="Brand" Margin="0,0,12,0"/>
                <TextBlock Text="Автобус 2:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="cmbSecond" Width="220" DisplayMemberPath="Brand" Margin="0,0,12,0"/>
                <Button Content="Сравнить" Width="100" Click="btncompare_Click"/>
            </StackPanel>
        </GroupBox>
        <TextBlock x:Name="txtResult" Grid.Row="4" Margin="0,8,0,0" FontSize="14"/>
    </Grid>
</Window>
